<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.skycloak.keycloak</groupId>
    <artifactId>keycloak-idp-discovery</artifactId>
    <version>0.2.0</version>
    <packaging>jar</packaging>

    <name>Keycloak IdP Discovery</name>
    <description>Redirects a user straight to their linked identity provider during login, without a password prompt in between. Built for split (multi-step) identity-first login flows, where the username and password are two separate pages rather than one combined form.</description>
    <url>https://github.com/sky-cloak/keycloak-idp-discovery</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Pinned to the fleet image version. Unlike our other extensions, this one
             extends Keycloak's internal implementation classes, not just the public
             SPI, so other 26.x versions are not expected to compile without changes
             (confirmed: 26.2.0 does not). See VERSIONING.md. -->
        <keycloak.version>26.7.3</keycloak.version>

        <jakarta.ws.rs.version>3.1.0</jakarta.ws.rs.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- Keycloak SPIs are provided by the server at runtime. -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-core</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi-private</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-services</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>${jakarta.ws.rs.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Produces target/keycloak-idp-discovery.jar - a clean name to drop into providers/. -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
